# ─────────────────────────────────────────────────────────────────────────────
#  BREWDECK — phone-call path only
# ─────────────────────────────────────────────────────────────────────────────
#
#  You do NOT need this file for normal use. The browser/phone UI works with
#  zero configuration — just `npm start`.
#
#  This is only for the ☎️ phone-call feature (dial a number, talk to Claude
#  Code). Copy it to `.env` and fill it in:
#
#      cp .env.example .env
#
#  `.env` is gitignored. Never move it into public/ — that directory is served
#  statically without auth.
# ─────────────────────────────────────────────────────────────────────────────

# ── Twilio ── carries the call audio. Buy a voice-capable number, then set its
#    "A Call Comes In" webhook (HTTP POST) to:
#        https://<CALL_PUBLIC_HOST>/twilio/voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Deepgram ── streaming speech-to-text
DEEPGRAM_API_KEY=

# ── ElevenLabs ── streaming text-to-speech.
#    VOICE_ID must be a voice that exists on your account — a wrong one closes
#    the socket with 1008 and you get total silence on the call.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Who may call ── comma-separated, any format (auto-normalised to E.164).
#    This is the front door. Combined with Twilio request-signature validation,
#    since caller ID on its own is spoofable.
CALL_ALLOW_FROM=

# ── Public hostname Twilio can reach ── e.g. a Tailscale Funnel host.
#    Expose it with:
#        tailscale funnel --bg "https+insecure://localhost:8443"
#    (the https+insecure:// prefix matters — plain `--bg 8443` assumes an HTTP
#     backend and returns 502, because BREWDECK serves HTTPS)
CALL_PUBLIC_HOST=

# ── Optional ──────────────────────────────────────────────────────────────────
# CALL_GREETING=Hi, this is Claude. How can I help?
# CALL_MODEL=            # pin a model (haiku|sonnet|opus). Default: auto-routed
# CALL_EFFORT=           # pin effort (low|medium|high|max)
# CALL_BUDGET_USD=1      # spend cap per turn
# CALL_BROWSER_EXE=      # path to a specific Chrome/Edge for browser control
